# The relay's settings. Copy this file to relay/.env (git ignores it) or set them in your host's
# dashboard. Setup and hosting: docs/dashboard/datasources.md › Relay.

# Where it listens. On this machine (the default) it needs no token; anywhere else it refuses to
# start without one. Container hosts usually set PORT, which the relay also reads.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# Every query must carry this as a bearer token: paste it into the connection's "Relay token".
# At least 32 characters, e.g. from `openssl rand -base64 32`.
RELAY_TOKEN=

# Pages that may call the relay: the dev server, the preview server, and your deployed site.
RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Database hosts it connects to; `*.` matches subdomains. Leave out localhost once it's deployed,
# so the token can't reach services on the relay's own machine.
RELAY_ALLOWED_HOSTS=*.database.windows.net,*.mongodb.net,localhost,127.0.0.1

# The most rows one query returns (at most 100000), and how long a query may run.
RELAY_MAX_ROWS=10000
RELAY_TIMEOUT_MS=30000
