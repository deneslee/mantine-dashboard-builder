{
  "name": "dashboard-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Runs SQL Server and MongoDB queries for the dashboard builder, which browsers can't. Stateless: the connection string comes with each request.",
  "scripts": {
    "dev": "vpx --watch src/server.ts",
    "build": "vp pack src/server.ts --out-dir dist --platform node",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "mongodb": "7.7.0",
    "mongodb-connection-string-url": "7.0.2",
    "mssql": "12.7.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.5",
    "vite-plus": "catalog:"
  }
}
