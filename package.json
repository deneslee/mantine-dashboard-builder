{
  "name": "dashboard-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "dev:devtools": "vp dev --mode devtools",
    "relay": "pnpm --filter dashboard-relay dev",
    "build": "vp run check:build",
    "build:analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "typecheck": "vp run check:lint",
    "lint": "vp run check:lint && vp run check:css",
    "lint:code": "vp run check:lint",
    "lint:css": "vp run check:css",
    "lint:fix": "pnpm lint:code:fix && pnpm lint:css:fix",
    "lint:code:fix": "vp lint --fix",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "format": "vp fmt .",
    "format:check": "vp run check:fmt",
    "test": "vp run check:test",
    "test:unit": "vp run check:unit",
    "test:stories": "vp run check:stories",
    "test:changed": "vp test run --changed",
    "test:watch": "vp test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deps": "pnpm outdated -r",
    "deps:up": "pnpm up -r -i -L",
    "deps:mantine": "pnpm up -r -L \"@mantine/*\" postcss-preset-mantine",
    "deps:tanstack": "pnpm up -r -L \"@tanstack/*\"",
    "deps:react": "pnpm up -r -L react react-dom @types/react @types/react-dom",
    "deps:storybook": "pnpm up -r -L storybook \"@storybook/*\"",
    "deps:testing": "pnpm up -r -L \"@testing-library/*\" jsdom msw playwright",
    "prepare": "vp config"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "3.1157.0",
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/client-rds-data": "3.1157.0",
    "@aws-sdk/client-redshift-data": "3.1157.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@mantine/charts": "9.7.4",
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/nprogress": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@sentry/react": "10.75.2",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "immer": "^11.2.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-grid-layout": "2.2.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-mcp": "^10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/devtools": "0.8.0",
    "@vitejs/devtools-rolldown": "0.8.0",
    "@vitejs/devtools-vite": "^0.8.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "catalog:",
    "code-inspector-plugin": "2.0.9",
    "jsdom": "^30.1.1",
    "msw": "^2.12.0",
    "oxc-transform-react": "0.152.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.6.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
